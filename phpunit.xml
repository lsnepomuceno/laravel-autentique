<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" backupGlobals="false" bootstrap="./vendor/autoload.php"
         colors="true" processIsolation="false" stopOnFailure="false"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.0/phpunit.xsd" cacheDirectory=".phpunit.cache"
         backupStaticProperties="false">
    <testsuites>
        <testsuite name="LSNepomuceno/LaravelAutentique Test Suite">
            <directory>./tests/</directory>
        </testsuite>
    </testsuites>
    <!-- Drives both line coverage and Pest's type coverage. -->
    <source>
        <include>
            <directory>./src</directory>
        </include>
    </source>
    <php>
        <env name="APP_KEY" value="testing"/>
        <!-- No test reaches Autentique: every request is faked. The token is
             set so the code path that sends it runs, and it opens nothing. -->
        <env name="AUTENTIQUE_TOKEN" value="testing"/>
    </php>
</phpunit>
